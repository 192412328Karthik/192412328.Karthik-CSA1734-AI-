
from itertools import permutations

# Letters used in the puzzle
letters = "SENDMORY"

# Try different digit assignments
for digits in permutations(range(10), len(letters)):
    d = dict(zip(letters, digits))

    # First letters cannot be zero
    if d['S'] == 0 or d['M'] == 0:
        continue

    # Form the numbers
    SEND = 1000*d['S'] + 100*d['E'] + 10*d['N'] + d['D']
    MORE = 1000*d['M'] + 100*d['O'] + 10*d['R'] + d['E']
    MONEY = (10000*d['M'] + 1000*d['O'] +
             100*d['N'] + 10*d['E'] + d['Y'])

    # Check the equation
    if SEND + MORE == MONEY:
        print("Solution found:")
        print("SEND =", SEND)
        print("MORE =", MORE)
        print("MONEY =", MONEY)
        print(SEND, "+", MORE, "=", MONEY)
        break
