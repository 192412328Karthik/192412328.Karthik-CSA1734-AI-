
from itertools import permutations

# Distance between cities
cities = ['A', 'B', 'C', 'D']

distance = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

start = 'A'
start_index = cities.index(start)

# Other cities except the starting city
others = [city for city in cities if city != start]

min_distance = float('inf')
best_route = None

# Check all possible routes
for route in permutations(others):
    full_route = (start,) + route + (start,)
    total = 0

    for i in range(len(full_route) - 1):
        a = cities.index(full_route[i])
        b = cities.index(full_route[i + 1])
        total += distance[a][b]

    if total < min_distance:
        min_distance = total
        best_route = full_route

# Display the result
print("Shortest Route:", " -> ".join(best_route))
print("Minimum Distance:", min_distance)
